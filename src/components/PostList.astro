---
import type { PostSummary } from '../lib/posts';

interface Props {
	posts: Array<PostSummary>;
}

const { posts } = Astro.props;
---

<main class="posts">
	{posts.map((post) => (
		<article id={post.slug} class="article-summary scroll-mt-8">
			<header>
				<time class="date post-meta" datetime={post.publishedDate} data-vt="date">
					{post.publishedFormatted}
				</time>
				,{' '}
				<span class="readTime post-meta" data-vt="read">
					{post.readTime}
				</span>
				<a href={`/posts/${post.slug}/`}>
					<h3 class="post-title" data-vt="title">
						{post.title}
					</h3>
				</a>
				<p class="flex justify-center gap-1 text-sm leading-normal sm:text-base">
					{post.tags.map((tag) => (
						<a href={`/tag/${tag}/`} class="tag-link">
							#{tag}
						</a>
					))}
				</p>
			</header>
			<p class="description">{post.description}</p>
		</article>
	))}
</main>

<style>
	@reference 'tailwindcss';
	.posts {
		@apply mb-10 px-6;
		margin-inline: max(0px, round(up, (100% - 48rem) / 2, 1px));
	}
	.article-summary {
		@apply border-b border-lime-300 py-4 text-center text-gray-700 sm:py-8 dark:text-gray-300;
	}
	.tag-link {
		@apply italic underline decoration-transparent transition duration-500 hover:decoration-gray-400;
	}
	.date {
		@apply text-xs uppercase;
	}
	.readTime {
		@apply ml-1 text-xs uppercase;
	}
	.description {
		@apply mt-6 px-2 text-base leading-normal sm:px-4 sm:text-lg md:px-10;
	}
</style>
